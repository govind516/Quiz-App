# ---- Backend (Spring Boot on Render) ----

# Supabase Postgres connection string.
# Session pooler (recommended): jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Direct (IPv6 only):           jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
DB_URL=
DB_USERNAME=postgres
DB_PASSWORD=

# 32+ byte random string (openssl rand -base64 48)
JWT_SECRET=
JWT_ACCESS_TTL_MS=900000
JWT_REFRESH_TTL_MS=604800000

# Comma-separated list of allowed frontend origins (Render URL + localhost for dev)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://quiz-app-frontend.onrender.com

ADMIN_EMAIL=
ADMIN_PASSWORD=
SEED_DEMO_DATA=true
DDL_AUTO=update
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=2

# Gemini AI question generation (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Confirm the current free-tier model name in Google AI Studio before deploying
GEMINI_MODEL=gemini-2.0-flash

# ---- Frontend (Next.js on Render) ----
# Base URL of the backend service (no trailing slash)
NEXT_PUBLIC_API_URL=https://quiz-app-backend.onrender.com
